# BhoomiVerify Backend Environment Variables
PROJECT_NAME="BhoomiVerify - Land Record Digitization and Validation"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security / JWT
SECRET_KEY="bhoomi-verify-super-secure-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database (PostgreSQL + PostGIS in production, SQLite fallback for local test/dev)
# Set DATABASE_URL to "sqlite:///./bhoomi_verify.db" or leave empty to use PostgreSQL params
DATABASE_URL="sqlite:///./bhoomi_verify.db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="bhoomi"
POSTGRES_PASSWORD="bhoomi_secure_password"
POSTGRES_DB="bhoomidb"

# Redis Cache (graceful in-memory cache used when Redis is unavailable)
REDIS_URL="redis://localhost:6379/0"

# Demo Mode (Enable synthetic test cases Scenario A, B, C)
ENABLE_DEMO_MODE=True

# Government State Credentials (API Setu / State Gateways)
# Note: In accordance with DILRMP standards, leave blank if not issued official credentials.
API_SETU_CLIENT_ID=""
API_SETU_API_KEY=""
MAHARASHTRA_API_KEY=""
KARNATAKA_API_KEY=""
GUJARAT_API_KEY=""
UTTAR_PRADESH_API_KEY=""
TAMIL_NADU_API_KEY=""
TELANGANA_API_KEY=""
ANDHRA_PRADESH_API_KEY=""
MADHYA_PRADESH_API_KEY=""
RAJASTHAN_API_KEY=""
